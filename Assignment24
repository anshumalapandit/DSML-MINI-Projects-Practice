import pandas as pd

# Load any dataset
df = pd.read_csv("your_dataset.csv")

print("Original Data:")
print(df.head())

# ----------------------------------------
# 1. COUNT UNIQUE VALUES IN EACH COLUMN
# ----------------------------------------
print("\nUnique values count:")
print(df.nunique())

# ----------------------------------------
# 2. FORMAT (DATA TYPE) OF EACH COLUMN
# ----------------------------------------
print("\nData types of columns:")
print(df.dtypes)

# ----------------------------------------
# 3. CONVERTING VARIABLE DATA TYPES
# ----------------------------------------

# Example: Convert integer column to float
if 'Age' in df.columns:
    df['Age'] = df['Age'].astype(float)

# Example: Convert float column to integer
if 'Salary' in df.columns:
    df['Salary'] = df['Salary'].astype(int)

# Example: Convert column to string
df['any_column_name'] = df['any_column_name'].astype(str) if 'any_column_name' in df.columns else None

print("\nData types after conversion:")
print(df.dtypes)

# ----------------------------------------
# 4. IDENTIFY MISSING VALUES
# ----------------------------------------
print("\nMissing values in each column:")
print(df.isnull().sum())

# ----------------------------------------
# 5. FILL MISSING VALUES
# ----------------------------------------

# Fill numeric missing values with mean
num_cols = df.select_dtypes(include=['int64','float64']).columns
df[num_cols] = df[num_cols].fillna(df[num_cols].mean())

# Fill categorical missing values with mode
cat_cols = df.select_dtypes(include=['object']).columns
df[cat_cols] = df[cat_cols].fillna(df[cat_cols].mode().iloc[0])

print("\nMissing values AFTER filling:")
print(df.isnull().sum())
