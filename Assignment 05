import pandas as pd
from sklearn.tree import DecisionTreeClassifier

# -----------------------------
# 1. Load dataset
# -----------------------------
df = pd.read_excel("/mnt/data/Age Table.xlsx")

# Features and target
X = df[["Age", "Income", "Married", "Health"]]
y = df["Class"]

# Convert categorical columns to numbers automatically
X_encoded = pd.get_dummies(X)

# -----------------------------
# 2. Train Decision Tree
# -----------------------------
model = DecisionTreeClassifier()
model.fit(X_encoded, y)

# -----------------------------
# 3. Test instance to predict
# Age = Young, Income = Low, Married = Yes, Health = Fair
# -----------------------------
test_data = pd.DataFrame([{
    "Age": "Young",
    "Income": "Low",
    "Married": "Yes",
    "Health": "Fair"
}])

test_encoded = pd.get_dummies(test_data)

# Match missing columns
test_encoded = test_encoded.reindex(columns=X_encoded.columns, fill_value=0)

# -----------------------------
# 4. Prediction
# -----------------------------
prediction = model.predict(test_encoded)[0]

print("Prediction for test data:", prediction)
