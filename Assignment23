import pandas as pd
import numpy as np
from math import log2

# -----------------------------------
# 1. CREATE DATAFRAME (from question)
# -----------------------------------
data = {
    "Age": ["Young","Young","Middle","Old","Old","Old","Middle","Young",
            "Young","Old","Young","Middle","Middle","Old"],
    "Income": ["High","High","High","Medium","Low","Low","Low","Medium",
               "Low","Medium","Medium","Medium","High","Medium"],
    "Married": ["No","No","No","No","Yes","Yes","Yes","No",
                "Yes","Yes","Yes","No","No","No"],
    "Health": ["Fair","Good","Fair","Fair","Fair","Good","Good","Fair",
               "Fair","Fair","Good","Good","Fair","Good"],
    "Class": ["No","No","Yes","Yes","Yes","No","Yes","No",
              "Yes","Yes","Yes","Yes","Yes","No"]
}

df = pd.DataFrame(data)

# -----------------------------------
# 2. FREQUENCY TABLE FOR Age vs Class
# -----------------------------------
freq_table = pd.crosstab(df["Age"], df["Class"])
print("Frequency Table:\n")
print(freq_table)

# -----------------------------------
# 3. ENTROPY FUNCTION
# -----------------------------------
def entropy(col):
    values = col.value_counts(normalize=True)
    return -sum(values * np.log2(values))

# -----------------------------------
# 4. TOTAL ENTROPY OF CLASS
# -----------------------------------
total_entropy = entropy(df["Class"])
print("\nTotal Entropy:", total_entropy)

# -----------------------------------
# 5. ENTROPY AFTER SPLIT ON AGE
# -----------------------------------
age_groups = df.groupby("Age")

weighted_entropy = 0
for age, group in age_groups:
    w = len(group) / len(df)
    weighted_entropy += w * entropy(group["Class"])

print("\nWeighted Entropy (Age split):", weighted_entropy)

# -----------------------------------
# 6. INFORMATION GAIN
# -----------------------------------
info_gain = total_entropy - weighted_entropy
print("\nInformation Gain (Age):", info_gain)
