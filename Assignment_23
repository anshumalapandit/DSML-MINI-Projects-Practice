import pandas as pd
import numpy as np
from math import log2

# -----------------------------
# CREATE DATAFRAME
# -----------------------------
data = {
    "Age": ["Young","Young","Middle","Old","Old","Old","Middle","Young",
            "Young","Old","Young","Middle","Middle","Old"],
    "Income": ["High","High","High","Medium","Low","Low","Low","Medium",
               "Low","Medium","Medium","Medium","High","Medium"],
    "Married": ["No","No","No","No","Yes","Yes","Yes","No",
                "Yes","Yes","Yes","No","No","No"],
    "Health": ["Fair","Good","Fair","Fair","Fair","Good","Good","Fair",
               "Fair","Fair","Good","Good","Fair","Good"],
    "Class": ["No","No","Yes","Yes","Yes","No","Yes","No",
              "Yes","Yes","Yes","Yes","Yes","No"]
}

df = pd.DataFrame(data)

# -----------------------------
# FREQUENCY TABLE FOR AGE
# -----------------------------
print("Frequency Table (Age vs Class):\n")
print(pd.crosstab(df["Age"], df["Class"]))

# -----------------------------
# ENTROPY FUNCTION
# -----------------------------
def entropy(col):
    p = col.value_counts(normalize=True)
    return -sum(p * np.log2(p))

# -----------------------------
# TOTAL ENTROPY
# -----------------------------
total_entropy = entropy(df["Class"])
print("\nTotal Entropy:", total_entropy)

# -----------------------------
# WEIGHTED ENTROPY (Age split)
# -----------------------------
weighted_entropy = 0
for age_value, group in df.groupby("Age"):
    w = len(group) / len(df)
    weighted_entropy += w * entropy(group["Class"])
    print(f"Entropy({age_value}) =", entropy(group["Class"]))

print("\nWeighted Entropy:", weighted_entropy)

# -----------------------------
# INFORMATION GAIN
# -----------------------------
IG = total_entropy - weighted_entropy
print("\nInformation Gain (Age):", IG)
